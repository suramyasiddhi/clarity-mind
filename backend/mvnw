#!/bin/sh
if command -v mvn >/dev/null 2>&1; then
    mvn "$@"
elif [ -f "$HOME/.m2/wrapper/dists/apache-maven-3.9.16/*/bin/mvn" ]; then
    "$HOME/.m2/wrapper/dists/apache-maven-3.9.16"/*/bin/mvn "$@"
else
    echo "Maven not found on PATH. Please install Maven or add it to PATH." >&2
    exit 1
fi

